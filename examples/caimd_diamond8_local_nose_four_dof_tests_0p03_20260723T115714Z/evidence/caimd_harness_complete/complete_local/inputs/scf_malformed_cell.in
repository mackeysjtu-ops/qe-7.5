&CONTROL
 calculation='scf',
 prefix='scf_malformed_cell',
 outdir='./tmp',
 pseudo_dir='/Users/mengqicheng/Downloads/Learning/qe-7.5/examples/caimd_diamond8_local_nose_four_dof_tests_0p03_20260723T115714Z/evidence/caimd_harness_complete/complete_local/pseudopotentials',
 tstress=.true.,
 tprnfor=.true.,
 nstep=4,
 dt=5.0,
 verbosity='high',
 
/
&SYSTEM
 ibrav=0,
 nat=2,
 ntyp=1,
 ecutwfc=12,
 ecutrho=48,
 occupations='smearing',
 smearing='gaussian',
 degauss=0.01,
 
/
&ELECTRONS
 conv_thr=1.0d-4,
 electron_maxstep=30,
 mixing_beta=0.30,
/


&CELL
 
 press=0.0,
 wmass=20.0,
 cell_dofree='all',
 
 caimd=.false., bogus_caimd_key=1,
/


ATOMIC_SPECIES
 C 12.011 C.UPF
CELL_PARAMETERS bohr
     6.74000000     0.00000000     0.00000000
     0.00000000     6.74000000     0.00000000
     0.00000000     0.00000000     6.74000000
ATOMIC_POSITIONS crystal
 C   0.000000   0.000000   0.000000
 C   0.250000   0.250000   0.250000
K_POINTS gamma
