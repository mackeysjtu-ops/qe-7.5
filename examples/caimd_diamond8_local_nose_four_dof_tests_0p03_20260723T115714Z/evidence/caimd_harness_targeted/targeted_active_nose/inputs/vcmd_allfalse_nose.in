&CONTROL
 calculation='vc-md',
 prefix='vcmd_allfalse_nose',
 outdir='./tmp',
 pseudo_dir='/Users/mengqicheng/Downloads/Learning/qe-7.5/examples/caimd_diamond8_local_nose_four_dof_tests_0p03_20260723T115714Z/evidence/caimd_harness_targeted/targeted_active_nose/pseudopotentials',
 tstress=.true.,
 tprnfor=.true.,
 nstep=20,
 dt=5.0,
 verbosity='high',
 
/
&SYSTEM
 ibrav=0,
 nat=2,
 ntyp=1,
 ecutwfc=12,
 ecutrho=48,
 occupations='smearing',
 smearing='gaussian',
 degauss=0.01,
 nosym=.true., noinv=.true.,
/
&ELECTRONS
 conv_thr=1.0d-4,
 electron_maxstep=30,
 mixing_beta=0.30,
/

&IONS
 ion_dynamics='beeman',
 
 ion_velocities='from_input',
 ion_temperature='nose', tempw=300.0, fnosep(1)=100.0, nhpcl=1, ndega=0,
/


&CELL
 cell_dynamics='pr',
 press=0.0,
 wmass=2000.0,
 cell_dofree='all',
 
 caimd=.true., caimd_stride=1, caimd_mask(1)=.false., caimd_mask(2)=.false., caimd_mask(3)=.false., caimd_mask(4)=.false., caimd_mask(5)=.false., caimd_mask(6)=.false.,
/


ATOMIC_SPECIES
 C 12.011 C.UPF
CELL_PARAMETERS bohr
     6.74000000     0.00000000     0.00000000
     0.00000000     6.74000000     0.00000000
     0.00000000     0.00000000     6.74000000
ATOMIC_POSITIONS crystal
 C   0.000000   0.000000   0.000000
 C   0.250000   0.250000   0.250000
K_POINTS gamma
ATOMIC_VELOCITIES { a.u }
 C  2.40000000e-04 -1.20000000e-04  1.80000000e-04
 C -2.40000000e-04  1.20000000e-04 -1.80000000e-04
