! JOB 1: vc-relax of 8-atom diamond to 0 kbar. ibrav=1 (simple cubic) so cell_dofree='volume'
! is accepted (source: init_dofree allows 'volume' only for ibrav=1). NC LDA C.UPF -> 80/320 Ry.
&CONTROL
  calculation = 'vc-relax',
  restart_mode = 'from_scratch',
  prefix = 'diamond8_vcrelax',
  pseudo_dir = '../pseudo',
  outdir = './tmp',
  nstep = 120,
  tstress = .true.,
  tprnfor = .true.,
  forc_conv_thr = 1.0d-4,
  disk_io = 'low',
  verbosity = 'high',
/
&SYSTEM
  ibrav = 1,
  celldm(1) = 6.7406530895,
  nat = 8,
  ntyp = 1,
  ecutwfc = 80.0,
  ecutrho = 320.0,
  occupations = 'fixed',
  nosym = .true.,
  noinv = .true.,
/
&ELECTRONS
  conv_thr = 1.0d-8,
  electron_maxstep = 120,
  mixing_beta = 0.30,
  diagonalization = 'david',
/
&IONS
  ion_dynamics = 'bfgs',
/
&CELL
  cell_dynamics = 'bfgs',
  press = 0.0,
  press_conv_thr = 0.5,
  cell_dofree = 'volume',
/
ATOMIC_SPECIES
C 12.01070000 C.UPF
ATOMIC_POSITIONS crystal
C  0.00000000000000  0.00000000000000  0.00000000000000
C  0.00000000000000  0.50000000000000  0.50000000000000
C  0.50000000000000  0.00000000000000  0.50000000000000
C  0.50000000000000  0.50000000000000  0.00000000000000
C  0.25000000000000  0.25000000000000  0.25000000000000
C  0.25000000000000  0.75000000000000  0.75000000000000
C  0.75000000000000  0.25000000000000  0.75000000000000
C  0.75000000000000  0.75000000000000  0.25000000000000
K_POINTS automatic
2 2 2 0 0 0
